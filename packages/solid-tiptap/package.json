{
  "name": "solid-tiptap",
  "version": "0.8.0",
  "description": "SolidJS bindings for Tiptap",
  "keywords": [
    "editor",
    "prosemirror",
    "rich-text",
    "solid-js",
    "tiptap"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-tiptap/tree/main/packages/solid-tiptap",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-tiptap/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-tiptap.git",
    "directory": "packages/solid-tiptap"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@solidjs/web": "2.0.0-rc.13",
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.1",
    "publint": "^0.3.25",
    "solid-js": "2.0.0-rc.13",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "solid-js": "^2.0.0-rc.13"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
