{
  "name": "solid-tiptap",
  "version": "0.9.0",
  "description": "SolidJS bindings for Tiptap",
  "keywords": [
    "editor",
    "prosemirror",
    "rich-text",
    "solid-js",
    "tiptap"
  ],
  "homepage": "https://github.com/lxsmnsyc/solid-tiptap/tree/main/packages/solid-tiptap",
  "bugs": {
    "url": "https://github.com/lxsmnsyc/solid-tiptap/issues"
  },
  "license": "MIT",
  "author": "Alexis Munsayac",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lxsmnsyc/solid-tiptap.git",
    "directory": "packages/solid-tiptap"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "type-check": "tsc --noEmit",
    "watch": "tsdown --watch"
  },
  "devDependencies": {
    "@tiptap/core": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "publint": "^0.3.25",
    "solid-js": "^1.9.15",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@tiptap/core": "^3",
    "@tiptap/pm": "^3",
    "solid-js": "^1.7"
  },
  "engines": {
    "node": ">=18"
  }
}
